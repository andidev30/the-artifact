{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install -g pnpm@11.6.0 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @the-artifact/web build && pnpm --filter @the-artifact/api build",
  "outputDirectory": "apps/web/dist",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "regions": ["hnd1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "apps/web/dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "the-artifact-content.vercel.app"
        }
      ],
      "destination": "https://the-artifact-pi.vercel.app/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/api"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api"
    },
    {
      "source": "/a/:slug",
      "destination": "/api"
    },
    {
      "source": "/e/:slug",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/readyz",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!api/|e/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/history",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/sweep",
      "schedule": "0 19 * * *"
    }
  ]
}
