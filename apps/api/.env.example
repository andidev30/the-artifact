# Where the web app is served. Used for redirects and links in emails.
APP_URL=http://localhost:5173

DATABASE_URL=postgres://artifact:artifact@localhost:5432/artifact

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local defaults point at Mailpit from docker-compose. Leave SMTP_HOST empty to try a server
# without email (password sign-in, links admins pass on).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Artifact <no-reply@localhost>"

# Self-hosted unless this says false. Set it to false to work on the hosted service's marketing pages.
# SELF_HOSTED=false

# Optional: Chrome or Chromium for gallery thumbnails; empty skips them
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Object storage for page content and thumbnails (any S3 API). Local defaults point at MinIO from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artifact
S3_ACCESS_KEY_ID=artifact
S3_SECRET_ACCESS_KEY=artifact-secret
