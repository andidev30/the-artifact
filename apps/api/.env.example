# Where the web app is served. Used for redirects and links in emails.
APP_URL=http://localhost:5173

DATABASE_URL=postgres://artifact:artifact@localhost:5432/artifact
# false behind a transaction-mode pooler (PgBouncer, Supabase on port 6543)
# DATABASE_PREPARE=false
# Connections per process; unset gives 10 to one process and about 20 in all to several
# DATABASE_POOL_MAX=10

# Node.js worker processes for `pnpm start` (node dist/index.js); unset is one per CPU, up to 8.
# pnpm dev always runs one process.
# WEB_CONCURRENCY=1

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local defaults point at Mailpit from docker-compose. Leave SMTP_HOST empty to try a server
# without email (password sign-in, links admins pass on).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Artifact <no-reply@localhost>"

# Self-hosted unless this says false. Set it to false to work on the hosted service's marketing pages.
# SELF_HOSTED=false

# Optional: bearer token for GET /api/cron/sweep, for hosts that schedule the storage sweep from outside (Vercel Cron)
# CRON_SECRET=

# Hosted service only: the Ed25519 private key that signs license keys for self-hosted installs,
# from `pnpm --filter @the-artifact/api license:keygen`. See docs/licenses.md.
# LICENSE_SIGNING_KEY=

# Optional: bearer token for Prometheus to scrape GET /metrics; without it, /metrics doesn't exist
# METRICS_TOKEN=

# Optional: false stops asking GitHub once a day for the newest release (the notice in the admin area)
# RELEASE_CHECK=false

# Optional: rate limits are on with the defaults in docs/configuration.md. "off" turns them all off,
# or change single ones, e.g. sign-in-link=20/1h,mcp=off
# RATE_LIMITS=
# Optional: which sites may embed pages in a frame: * (any, the default), none, or origins, e.g.
# https://www.notion.so,https://*.atlassian.net
# EMBED_FRAME_ANCESTORS=*
# Optional: a second origin that serves page files and nothing else, on another host than APP_URL.
# In development, the API's own address works: http://127.0.0.1:3000 next to APP_URL=http://localhost:5173
# CONTENT_ORIGIN=
# Optional: true behind a reverse proxy that sets X-Forwarded-For, so limits see each visitor's address
# TRUST_PROXY=true
# Optional: what one workspace may hold; no limit when unset
# WORKSPACE_MAX_PAGES=500
# WORKSPACE_MAX_VERSIONS=5000
# WORKSPACE_MAX_STORAGE=10GB
# Optional: days organizations' audit log events are kept (Enterprise); 365 when unset
# AUDIT_LOG_RETENTION_DAYS=365

# Optional: Chrome or Chromium for gallery thumbnails; empty skips them
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# How many thumbnails render at once, 1 to 8 (2 when unset)
# THUMBNAIL_CONCURRENCY=2

# Object storage for page content and thumbnails (any S3 API). Local defaults point at MinIO from docker-compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=artifact
S3_ACCESS_KEY_ID=artifact
S3_SECRET_ACCESS_KEY=artifact-secret
# Optional: where agents reach the bucket themselves, for publishing by direct upload. Empty keeps publishing inline only.
S3_PUBLIC_ENDPOINT=http://localhost:9000
