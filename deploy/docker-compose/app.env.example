# Settings for the app. From deploy/docker-compose: copy to app.env, edit, then
#   docker compose up -d
# and open APP_URL: the first account you create becomes the admin of this server.
# Every setting: docs/configuration.md
#
# The image version, the host port, the database and MinIO passwords and an external S3 store are read by
# docker compose itself, so they go in .env instead: cp .env.example .env
# (ARTIFACT_VERSION, ARTIFACT_PORT, POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD, S3_*). Lines for them here are ignored.

# The address people use to reach your install, without a trailing slash.
# Sign-in links, page links and the MCP URL are built from it.
APP_URL=http://localhost:8080

# Optional: email for sign-in links, invitations and share notices.
# Leave SMTP_HOST empty to run without email: people log in with a password, and
# admins pass sign-up and invitation links on themselves.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS, usually port 465
SMTP_SECURE=false
# Leave both empty for a server without authentication
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Artifact <artifact@example.com>"

# Optional: Google sign-in. Leave empty to hide the Google button.
# Redirect URI to register in Google Cloud: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: gallery thumbnails. The image renders them with its own headless Chromium;
# set CHROME_PATH= (empty) to turn them off.
# CHROME_PATH=
# Hosts pages may load scripts, styles and fonts from while their thumbnail renders
# (comma separated; "none" blocks all). Unset uses a built-in list of common CDNs.
# THUMBNAIL_CDN_HOSTS=cdn.jsdelivr.net,fonts.googleapis.com,fonts.gstatic.com

# Optional: Prometheus metrics at GET /metrics, scraped with this as a bearer token
# (e.g. openssl rand -hex 32). Without it, /metrics does not exist. See docs/self-hosting.md
# METRICS_TOKEN=

# Optional: the admin area says when a newer release is out, from GitHub's releases API asked once
# a day (nothing about this server is sent). false makes no request, for servers without internet
# RELEASE_CHECK=false

# Behind a reverse proxy (Caddy, nginx...) that is the only way to reach the app: true, so rate
# limits see each visitor's address instead of the proxy's. See docs/self-hosting.md
# TRUST_PROXY=true

# Optional: which sites may embed pages shared by link in a frame. Unset lets any site; "none" turns
# embedding off; or list origins, e.g. EMBED_FRAME_ANCESTORS=https://www.notion.so,https://*.atlassian.net
# EMBED_FRAME_ANCESTORS=

# Optional: rate limits are on with the defaults in docs/configuration.md. "off" turns them all off,
# or change single ones, e.g. RATE_LIMITS=mcp=2000/10m,publish=500/1h
# RATE_LIMITS=

# Optional: what one workspace (a personal workspace or an organization) may hold. No limit when unset.
# WORKSPACE_MAX_PAGES=500
# WORKSPACE_MAX_VERSIONS=5000
# WORKSPACE_MAX_STORAGE=10GB
