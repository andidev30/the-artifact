# Settings docker compose reads itself: copy to .env in this folder.
# App settings (APP_URL, email, Google) go in app.env instead; see app.env.example.
# Everything here is optional. Set the passwords before the first start: the database and
# MinIO keep the ones they were created with.

# Release of the published image (ghcr.io/andidev30/the-artifact) to run: an exact version, or
# major.minor (e.g. 0.2) to get that line's fixes on docker compose pull. To update, read the
# release notes, set the new version and run docker compose up -d (see docs/upgrading.md).
# Releases: https://github.com/andidev30/the-artifact/releases
# x-release-please-start-version
ARTIFACT_VERSION=1.1.0
# x-release-please-end

# Build the image from this checkout instead of pulling it (see docker-compose.build.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Port on this machine the app listens on
ARTIFACT_PORT=8080
# Address on this machine the app listens on. 127.0.0.1 lets only this machine in, e.g. a reverse
# proxy running here. 0.0.0.0 lets in every network the machine is on: then leave TRUST_PROXY unset
# in app.env, since anyone reaching the port could claim any address in X-Forwarded-For.
ARTIFACT_BIND=127.0.0.1

# Password of the bundled Postgres
POSTGRES_PASSWORD=change-me

# Password of the bundled MinIO; the app uses it to reach MinIO
MINIO_ROOT_PASSWORD=change-me-too

# Object storage somewhere else instead of the bundled MinIO. Uncomment one block, then remove
# the minio service and the app's depends_on: minio from docker-compose.yml.
# S3_PUBLIC_ENDPOINT is where agents can reach the bucket themselves: it turns on publishing by
# direct upload and exports that download straight from the bucket (see docs/configuration.md).

# AWS S3 (empty endpoint)
# S3_ENDPOINT=
# S3_REGION=eu-central-1
# S3_BUCKET=artifact
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_ENDPOINT=https://s3.eu-central-1.amazonaws.com

# Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=artifact
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Your own MinIO, Backblaze B2, Google Cloud Storage (interoperability keys)...
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=us-east-1
# S3_BUCKET=artifact
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
