# Settings for The Artifact, like deploy/docker-compose/app.env with docker compose. Copy to app.env and edit,
# then kubectl apply -k deploy/kubernetes. Every setting: docs/configuration.md

# The address people use, without a trailing slash. Use the host from ingress.yaml.
APP_URL=https://artifact.example.com

# Recommended: encrypts the keys the server keeps in its database (authenticator apps, webhooks,
# single sign-on, page links), so a copy of the database alone doesn't give them away. Make one with
#   openssl rand -base64 32
# and keep a copy apart from your backups: once set, the server needs it to start. See docs/configuration.md
# ENCRYPTION_KEY=

# Database. With the bundled Postgres (postgres.yaml), keep the URL and change the password in
# both lines before the first apply; letters and digits only, since it goes into the URL.
# With your own Postgres, put its URL here and remove postgres.yaml from kustomization.yaml.
DATABASE_URL=postgres://artifact:change-me@postgres:5432/artifact
POSTGRES_PASSWORD=change-me
# false when DATABASE_URL goes through a transaction-mode pooler (PgBouncer, Supabase on port 6543)
# DATABASE_PREPARE=false

# Object storage. These point at the bundled MinIO (minio.yaml), which uses
# S3_SECRET_ACCESS_KEY as its password: change it before the first apply.
# For S3, R2 or another store, put its settings here and remove minio.yaml from kustomization.yaml
# (R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto; AWS: S3_ENDPOINT=).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=artifact
S3_ACCESS_KEY_ID=artifact
S3_SECRET_ACCESS_KEY=change-me-too
# Where agents can reach the bucket themselves (S3, R2; not the bundled MinIO, which is inside the
# cluster). Turns on publishing by direct upload and exports that download straight from the bucket.
# S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Optional: email. Leave SMTP_HOST empty to run without it (password sign-in, links you pass on).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Artifact <artifact@example.com>

# Optional: Google sign-in. Redirect URI to register: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: how many gallery thumbnails render at once, 1 to 8 (2 when unset; about 150 new pages a
# minute). Raise it when the thumbnail queue keeps growing; each extra render costs some memory and CPU.
# THUMBNAIL_CONCURRENCY=2
# Hosts pages may load scripts, styles and fonts from while their thumbnail renders
# (comma separated; "none" blocks all). Unset uses a built-in list of common CDNs.
# THUMBNAIL_CDN_HOSTS=cdn.jsdelivr.net,fonts.googleapis.com,fonts.gstatic.com

# Worker processes (WEB_CONCURRENCY) are set in app.yaml, next to the pod's resources. Database
# connections per worker: 10 with one worker, about 20 in all with more when unset.
# DATABASE_POOL_MAX=10

# Optional: Prometheus metrics at GET /metrics, scraped with this as a bearer token
# (e.g. openssl rand -hex 32). Without it, /metrics does not exist. See docs/self-hosting.md
# METRICS_TOKEN=

# Optional: the code the first account, this server's admin, is created with; at least 12 letters or
# digits. Unset prints a new one to the log on every start until the first account exists.
# SETUP_CODE=

# Optional: the admin area says when a newer release is out, from GitHub's releases API asked once
# a day (nothing about this server is sent). false makes no request, for clusters without internet
# RELEASE_CHECK=false

# People reach the app through the ingress, which adds their address to X-Forwarded-For; rate limits
# read it from there. Set it to false if nothing sits in front of the service.
TRUST_PROXY=true

# Optional: serve page files from a second domain of their own, so browsers never send the app's
# cookies where untrusted pages run. Another host than APP_URL, pointing at the same service; add it
# to ingress.yaml too. See docs/self-hosting.md
# CONTENT_ORIGIN=https://artifact-content.example.net

# Optional: which sites may embed pages shared by link in a frame. Unset lets any site; "none" turns
# embedding off; or list origins, e.g. EMBED_FRAME_ANCESTORS=https://www.notion.so,https://*.atlassian.net
# EMBED_FRAME_ANCESTORS=

# Optional: rate limits are on with the defaults in docs/configuration.md. "off" turns them all off,
# or change single ones, e.g. RATE_LIMITS=mcp=2000/10m,publish=500/1h
# RATE_LIMITS=

# Optional: what one workspace (a personal workspace or an organization) may hold. No limit when unset.
# WORKSPACE_MAX_PAGES=500
# WORKSPACE_MAX_VERSIONS=5000
# WORKSPACE_MAX_STORAGE=10GB

# Optional: days organizations' audit log events are kept (an Enterprise feature); 365 when unset
# AUDIT_LOG_RETENTION_DAYS=365
