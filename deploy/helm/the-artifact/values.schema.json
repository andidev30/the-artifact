{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": ["string", "number"]
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "appUrl": {
      "type": "string",
      "description": "The address people use, without a trailing slash",
      "pattern": "^(https?://[^/]+.*)?$"
    },
    "selfHosted": {
      "type": "boolean"
    },
    "trustProxy": {
      "description": "true, false, the number of proxies, or empty for true when the ingress is on",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(|true|false|[0-9]+)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rateLimits": {
      "type": "string"
    },
    "workspaceQuota": {
      "type": "object",
      "properties": {
        "maxPages": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^([0-9]*)$"
            }
          ]
        },
        "maxVersions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^([0-9]*)$"
            }
          ]
        },
        "maxStorage": {
          "type": "string",
          "pattern": "^(|[0-9]+(\\.[0-9]+)?\\s*([KMGT]?B)?)$"
        }
      }
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": ["integer", "string"]
        },
        "secure": {
          "type": "boolean"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      }
    },
    "google": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        }
      }
    },
    "thumbnails": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "seccompProfile": {
          "type": "string",
          "minLength": 1
        },
        "cdnHosts": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array"
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]*$"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretPasswordKey": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(|postgres(ql)?://.+)$"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "user": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "params": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretUrlKey": {
          "type": "string"
        },
        "existingSecretPasswordKey": {
          "type": "string"
        },
        "prepare": {
          "type": "boolean"
        }
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rootUser": {
          "type": "string",
          "minLength": 3
        },
        "rootPassword": {
          "type": "string",
          "pattern": "^(|.{8,})$"
        },
        "existingSecret": {
          "type": "string"
        },
        "bucket": {
          "type": "string",
          "minLength": 3
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "externalS3": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^(|https?://.+)$"
        },
        "region": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "accessKeyId": {
          "type": "string"
        },
        "secretAccessKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretAccessKeyIdKey": {
          "type": "string"
        },
        "existingSecretSecretAccessKeyKey": {
          "type": "string"
        },
        "publicEndpoint": {
          "type": "string",
          "pattern": "^(|https?://.+)$"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": ["object", "null"]
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
