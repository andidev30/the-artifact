{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this pull request tags the release, publishes the image, the Helm chart and the release notes. Before merging, check that every change that needs action on upgrade has a section in `docs/upgrading.md` (see CONTRIBUTING.md).",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "the-artifact",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "deploy/docker-compose/docker-compose.yml",
        "deploy/docker-compose/.env.example",
        "deploy/kubernetes/kustomization.yaml",
        { "type": "generic", "path": "deploy/helm/the-artifact/Chart.yaml" }
      ]
    }
  }
}
