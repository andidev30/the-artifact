# The address people use to reach your install, without a trailing slash.
# Sign-in links, page links and the MCP URL are built from it.
APP_URL=http://localhost:8080

# Email for sign-in links, invitations and share notices
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Artifact <artifact@example.com>"

# Optional: only these email domains may create accounts (comma separated), e.g. example.com.
# People from other domains can still join an organization or a page they were invited to.
# Leave empty to let anyone who can reach the server sign up.
ALLOWED_EMAIL_DOMAINS=
# (Once an admin saves a sign-up policy under Admin, Sign-up, that takes precedence.)

# Optional: these addresses are always instance admins (comma separated).
# The first account created on a new install becomes the admin anyway; use this
# to get into an existing install that has no admin.
ADMIN_EMAILS=

# Optional: Google sign-in. Leave empty to sign in by email only.
# Redirect URI to register in Google Cloud: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
